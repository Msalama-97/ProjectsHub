# Copy this file to .env and change the values before the first start.

# Port the app is reachable on:  http://<server-ip>:8080
APP_PORT=8080

# Database (only used inside Docker — pick any strong password)
POSTGRES_DB=projecthub
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=change-this-db-password

# First admin account — created automatically on the very first start only.
# Change the password after signing in (Settings > Change password).
ADMIN_NAME=Salama
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-2026

# Optional. Leave empty and a random secret is generated and stored in the app volume.
JWT_SECRET=

# Set to true only when serving over HTTPS (e.g. behind a reverse proxy with a certificate).
COOKIE_SECURE=false

# Max size of an uploaded document, in MB
MAX_UPLOAD_MB=50

# Timezone used by the server (affects "today" for runway / renewals)
TZ=Africa/Cairo
